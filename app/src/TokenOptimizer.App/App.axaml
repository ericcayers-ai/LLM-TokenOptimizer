<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TokenOptimizer.App.App"
             xmlns:local="using:TokenOptimizer.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <SolidColorBrush x:Key="SystemBlue" Color="#007AFF"/>
        <SolidColorBrush x:Key="SystemGreen" Color="#34C759"/>
        <SolidColorBrush x:Key="SystemRed" Color="#FF3B30"/>
        <SolidColorBrush x:Key="SystemOrange" Color="#FF9500"/>
        <SolidColorBrush x:Key="SystemGray" Color="#8E8E93"/>
        <SolidColorBrush x:Key="SystemGray2" Color="#AEAEB2"/>
        <SolidColorBrush x:Key="SystemGray3" Color="#C7C7CC"/>
        <SolidColorBrush x:Key="SystemGray4" Color="#D1D1D6"/>
        <SolidColorBrush x:Key="SystemGray5" Color="#E5E5EA"/>
        <SolidColorBrush x:Key="SystemGray6" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="LabelPrimary" Color="#000000"/>
        <SolidColorBrush x:Key="LabelSecondary" Color="#3C3C4399"/>
        <SolidColorBrush x:Key="LabelTertiary" Color="#3C3C434D"/>
        <SolidColorBrush x:Key="BGPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BGSecondary" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="BGTertiary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Separator" Color="#3C3C4349"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Apple HIG: Section Header -->
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
        </Style>

        <!-- Apple HIG: Sub Header -->
        <Style Selector="TextBlock.SubHeader">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
        </Style>

        <!-- Apple HIG: Card -->
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource BGPrimary}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemGray5}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Apple HIG: Primary Button -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource SystemBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Apple HIG: Destructive Button -->
        <Style Selector="Button.destructive">
            <Setter Property="Background" Value="{DynamicResource SystemRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Apple HIG: TextBox -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Apple HIG: ComboBox -->
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Apple HIG: TabControl -->
        <Style Selector="TabControl">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Apple HIG: TabItem -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Apple HIG: ProgressBar -->
        <Style Selector="ProgressBar">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Height" Value="6"/>
        </Style>

        <!-- Apple HIG: CheckBox -->
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Apple HIG: ListBox -->
        <Style Selector="ListBox">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Apple HIG: ItemsControl -->
        <Style Selector="ItemsControl">
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Application.Styles>
</Application>
