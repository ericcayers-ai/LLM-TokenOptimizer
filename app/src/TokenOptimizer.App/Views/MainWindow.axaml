<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TokenOptimizer.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
        x:Class="TokenOptimizer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="TokenOptimizer" Width="1100" Height="760" MinWidth="880" MinHeight="600">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.SubHeader">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,14,0,2" />
        </Style>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- Title bar -->
        <Border Grid.Row="0" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="Gray">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="TokenOptimizer" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" Opacity="0.65" VerticalAlignment="Center" />
                </StackPanel>
                <ProgressBar Grid.Column="1" Width="140" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main content: tabs -->
        <TabControl Grid.Row="1" Margin="8">

            <!-- ==================== SETUP TAB ==================== -->
            <TabItem Header="Setup">
                <ScrollViewer>
                    <StackPanel Margin="8">
                        <TextBlock Text="{Binding SetupStepsSummary}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid ColumnDefinitions="320,*">

                        <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,12,0">
                            <Border Classes="Card">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="①" FontWeight="Bold" />
                                        <TextBlock Text="Projects" Classes="SectionHeader" />
                                        <TextBlock Text="✓ done" Foreground="MediumSeaGreen" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding SetupStep1Done}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding ProjectHistoryList}"
                                             SelectedItem="{Binding SelectedProject}"
                                             Height="180">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding FullPath}" FontSize="10" Opacity="0.6" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="Add project folder" Classes="SubHeader" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" PlaceholderText="C:\path\to\project" Text="{Binding NewProjectPath}" />
                                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseProjectFolderCommand}" Margin="4,0,0,0" />
                                    </Grid>
                                    <Button Content="Add" Command="{Binding AddProjectCommand}" HorizontalAlignment="Stretch" />

                                    <TextBlock Text="Master folder" Classes="SubHeader" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding MasterFolderPath}" PlaceholderText="C:\path\to\projects" />
                                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseMasterFolderCommand}" Margin="4,0,0,0" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Set" Command="{Binding SetMasterFolderCommand}" />
                                        <Button Content="Refresh" Command="{Binding RefreshMasterFolderCandidatesCommand}" />
                                        <Button Content="{Binding MasterFolderTreeToggleLabel}" Command="{Binding ShowMasterFolderTreeCommand}" ToolTip.Tip="Show a tree of every subdirectory under this master folder - double-click one to launch a session there." />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding MasterFolderCandidates}" Height="120">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <CheckBox IsChecked="{Binding IsSelected}" />
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="(seen)" FontSize="10" Opacity="0.6" IsVisible="{Binding SeenBefore}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border IsVisible="{Binding IsMasterFolderTreeOpen}" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Height="260" ClipToBounds="True">
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="6">
                                            <TreeView ItemsSource="{Binding MasterFolderTree}">
                                                <TreeView.ItemTemplate>
                                                    <TreeDataTemplate ItemsSource="{Binding Children}">
                                                        <TextBlock Text="{Binding Name}"
                                                                   DoubleTapped="MasterFolderTreeNode_DoubleTapped" />
                                                    </TreeDataTemplate>
                                                </TreeView.ItemTemplate>
                                            </TreeView>
                                        </ScrollViewer>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Text="{Binding NewProjectFolderName}" PlaceholderText="new folder name" Width="150" />
                                        <Button Content="Create" Command="{Binding CreateProjectFolderCommand}" />
                                    </StackPanel>
                                    <Button Content="Launch Checked" Command="{Binding LaunchSelectedCandidatesCommand}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="10">
                            <Border Classes="Card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="②" FontWeight="Bold" />
                                            <TextBlock Text="Dependencies" Classes="SectionHeader" />
                                            <TextBlock Text="✓ done" Foreground="MediumSeaGreen" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding SetupStep2Done}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Content="Refresh" Command="{Binding RefreshAllCommand}" />
                                            <Button Content="Install Missing" Command="{Binding InstallMissingDependenciesCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Dependencies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding IsAvailable}" Width="36" FontSize="10" Opacity="0.8" />
                                                    <TextBlock Text="{Binding Name}" Width="90" />
                                                    <TextBlock Text="{Binding Version}" Opacity="0.6" FontSize="10" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ProgressBar Value="{Binding DependencyInstallProgress}" Minimum="0" Maximum="1"
                                                 IsVisible="{Binding IsDependencyInstalling}" Height="6" />
                                </StackPanel>
                            </Border>

                            <Border Classes="Card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="③" FontWeight="Bold" />
                                            <TextBlock Text="Companion tooling" Classes="SectionHeader" />
                                            <TextBlock Text="✓ done" Foreground="MediumSeaGreen" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding SetupStep3Done}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Install Companion Tooling" Command="{Binding InstallCompanionToolingCommand}" />
                                    </Grid>
                                    <TextBlock Text="graphify, claude-mem, headroom, rtk, context7, context-mode, caveman, claude-md-management, impeccable, task-observer, LM Studio support, and the Codex/Antigravity/Cursor fallback-chain CLIs."
                                               TextWrapping="Wrap" Opacity="0.7" FontSize="11" />
                                    <ProgressBar Value="{Binding CompanionToolingProgress}" Minimum="0" Maximum="1"
                                                 IsVisible="{Binding IsCompanionToolingInstalling}" Height="6" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== SESSION TAB ==================== -->
            <TabItem Header="Session">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="8">
                        <Border Classes="Card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Session Launch" Classes="SectionHeader" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <StackPanel Spacing="4" Width="220">
                                        <TextBlock Text="Provider" />
                                        <ComboBox ItemsSource="{Binding ProviderNames}"
                                                  SelectedItem="{Binding SelectedProviderName}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" Width="220">
                                        <TextBlock Text="Model override (optional)" />
                                        <ComboBox ItemsSource="{Binding ModelOverrideOptions}"
                                                  Text="{Binding ModelOverride}"
                                                  IsEditable="True"
                                                  PlaceholderText="e.g. sonnet, opus, qwen/qwen3-coder-30b"
                                                  HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="Options change with the selected Provider - pick one, or type any model name/id." />
                                    </StackPanel>
                                    <StackPanel Spacing="4" Width="130">
                                        <TextBlock Text="Resume mode" />
                                        <ComboBox ItemsSource="{Binding ResumeModeNames}"
                                                  SelectedItem="{Binding SelectedResumeModeName}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" VerticalAlignment="Bottom">
                                        <Button Content="Launch Session" Command="{Binding LaunchSessionCommand}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" VerticalAlignment="Bottom">
                                        <Button Content="Export Handoff" Command="{Binding ExportHandoffCommand}" />
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox Content="Isolate Claude config for this project (separate CLAUDE_CONFIG_DIR)" IsChecked="{Binding IsolateClaudeConfig}" />
                                <TextBlock Text="{Binding BestLocalModelText}" Opacity="0.7" FontSize="11" />

                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <StackPanel Spacing="4" Width="160">
                                        <TextBlock Text="LM Studio context preset" />
                                        <ComboBox ItemsSource="{Binding LmStudioPresetNames}"
                                                  SelectedItem="{Binding SelectedLmStudioPresetName}"
                                                  HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="Fast: smallest context, quickest load. Balanced: half the model's max context. Max: the model's full native context, scaled down automatically if this PC's VRAM/RAM looks tight, retried smaller on any real load failure." />
                                    </StackPanel>
                                    <StackPanel Spacing="4" VerticalAlignment="Bottom">
                                        <Button Content="Restart Local Model" Command="{Binding RestartLocalModelCommand}"
                                                ToolTip.Tip="Unloads whatever LM Studio has loaded and reloads it under the preset above." />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding LmStudioRestartStatusText}" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Fallback chain (priority order)" Classes="SectionHeader" />
                                <ItemsControl ItemsSource="{Binding FallbackChain}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding IsAvailable}" Width="36" FontSize="10" Opacity="0.8" />
                                                <TextBlock Text="{Binding ProviderName}" Width="100" />
                                                <TextBlock Text="{Binding UnavailableReason}" Opacity="0.6" FontSize="10" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Custom fallback chain" Classes="SectionHeader" />
                                        <TextBlock Text="Drag to reorder, uncheck to exclude. Select &quot;Custom (fallback chain)&quot; as the Provider above to use this order." Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Save Order" Command="{Binding SaveCustomFallbackOrderCommand}" VerticalAlignment="Top" />
                                </Grid>
                                <ListBox x:Name="CustomChainListBox" ItemsSource="{Binding CustomChainOrder}" Height="180">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                  PointerPressed="CustomChainItem_PointerPressed"
                                                  PointerReleased="CustomChainItem_PointerReleased"
                                                  Background="Transparent">
                                                <TextBlock Grid.Column="0" Text="::" FontWeight="Bold" Opacity="0.5" Width="20" Cursor="SizeAll" />
                                                <CheckBox Grid.Column="1" Content="{Binding ProviderName}" IsChecked="{Binding IsIncluded}" />
                                                <TextBlock Grid.Column="2" Text="{Binding SortIndex}" Opacity="0.4" FontSize="10" Width="20" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Content="↑"
                                                        Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).MoveCustomChainItemUpCommand}"
                                                        CommandParameter="{Binding}" Padding="6,2" />
                                                <Button Grid.Column="4" Content="↓"
                                                        Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).MoveCustomChainItemDownCommand}"
                                                        CommandParameter="{Binding}" Padding="6,2" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Fallback credentials" Classes="SectionHeader" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Text="{Binding CodexApiKeyInput}" PlaceholderText="OPENAI_API_KEY for Codex" Width="220" PasswordChar="*" />
                                    <Button Content="Save Codex Key" Command="{Binding SetCodexCredentialCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Text="{Binding GroqApiKeyInput}" PlaceholderText="GROQ_API_KEY for Groq" Width="220" PasswordChar="*" />
                                    <Button Content="Save Groq Key" Command="{Binding SetGroqCredentialCommand}" />
                                </StackPanel>
                                <TextBlock Text="⚠ Known issue: Groq currently fails to launch - Claude Code speaks the Anthropic Messages API protocol even when pointed at a different URL, and Groq only exposes an OpenAI-protocol endpoint, so every request is rejected. A protocol bridge is planned for a future release; the key can still be saved now."
                                           Foreground="Orange" FontSize="11" TextWrapping="Wrap" />

                                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Login: Antigravity" FontWeight="SemiBold" />
                                        <TextBlock Text="Opens the Antigravity CLI in a new window - sign in there (OAuth), then it's available in the fallback chain." Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Login: Antigravity" Command="{Binding LoginAntigravityCommand}" />
                                            <Button Content="Check" Command="{Binding CheckAntigravityLoginCommand}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding AntigravityLoginStatusText}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Login: Cursor" FontWeight="SemiBold" />
                                        <TextBlock Text="Opens 'cursor-agent login' in a new window - sign in there, then it's available in the fallback chain." Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Login: Cursor" Command="{Binding LoginCursorCommand}" />
                                            <Button Content="Check" Command="{Binding CheckCursorLoginCommand}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding CursorLoginStatusText}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== DASHBOARD TAB ==================== -->
            <TabItem Header="Dashboard">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="8">
                        <Border Classes="Card">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Active session" Classes="SectionHeader" />
                                    <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshDashboardCommand}" />
                                </Grid>
                                <StackPanel Spacing="4" Width="260">
                                    <TextBlock Text="Provider (switch on the fly)" />
                                    <ComboBox ItemsSource="{Binding ProviderNames}"
                                              SelectedItem="{Binding SelectedProviderName}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveProviderLabel}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TokenUsageSummaryText}" Opacity="0.75" FontSize="12"
                                           ToolTip.Tip="Via ccusage - local, offline, reads Claude Code/Codex/etc session logs already on disk. No proxy, no upload." />
                                <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsDashboardRefreshing}" />
                                <TextBlock Text="Switching providers applies to the NEXT session launch - Claude Code can't hot-swap the backend of an already-running session. Switching to/from Custom fallback chain also needs a fresh launch."
                                           TextWrapping="Wrap" Opacity="0.65" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Skills in use (Claude Code terminal)" Classes="SectionHeader" />
                                <TextBlock Text="Every provider routes through this one terminal, so these are always active regardless of the backend model selected above." Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding ActiveSkills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Plugins in use (Claude Code terminal)" Classes="SectionHeader" />
                                <ItemsControl ItemsSource="{Binding ActivePlugins}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Guide: what's available, and when to use it" Classes="SectionHeader" />
                                <TextBlock Text="Every skill/plugin this Claude Code environment can reach, with its own description - the same text Claude reads to decide when to trigger it." Opacity="0.6" FontSize="11" TextWrapping="Wrap" />

                                <TextBlock Text="Skills" Classes="SubHeader" />
                                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Height="220">
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding SkillGuide}" Margin="6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="160,Auto,*" Margin="0,3">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Source}" Opacity="0.5" FontSize="10" Margin="6,0" VerticalAlignment="Top" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Description}" Opacity="0.75" FontSize="11" TextWrapping="Wrap" Margin="6,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <TextBlock Text="Plugins" Classes="SubHeader" />
                                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Height="160">
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding PluginGuide}" Margin="6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="160,*" Margin="0,3">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Opacity="0.75" FontSize="11" TextWrapping="Wrap" Margin="6,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== BENCHMARK TAB ==================== -->
            <TabItem Header="Benchmark">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="8">
                        <Border Classes="Card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Benchmark" Classes="SectionHeader" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <StackPanel Spacing="4" Width="260">
                                        <TextBlock Text="Model (blank = all in catalog)" />
                                        <ComboBox ItemsSource="{Binding CatalogModels}"
                                                  SelectedItem="{Binding SelectedCatalogModel}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" Width="160">
                                        <TextBlock Text="Quality tier" />
                                        <ComboBox ItemsSource="{Binding QualityTierNames}"
                                                  SelectedItem="{Binding SelectedQualityTierName}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" VerticalAlignment="Bottom">
                                        <Button Content="Run Benchmark" Command="{Binding RunBenchmarkCommand}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" VerticalAlignment="Bottom">
                                        <Button Content="Refresh Leaderboard" Command="{Binding RefreshBestLocalModelCommand}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Export for AI Review"
                                            Command="{Binding ExportBenchmarksForAiReviewCommand}"
                                            ToolTip.Tip="Zips every benchmark result plus a ready-to-paste quality-review prompt, reveals the zip in Explorer, and copies the prompt to the clipboard." />
                                    <Button Content="Generate Report"
                                            Command="{Binding GenerateBenchmarkReportCommand}"
                                            ToolTip.Tip="Writes BENCHMARK_REPORT.md - scoring matrix and per-model averages only (no quality-review text, that's the AI-review zip's job) - and opens it." />
                                </StackPanel>
                                <TextBlock Text="{Binding BenchmarkStatusText}" Opacity="0.7" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Live run log" Classes="SectionHeader" />
                                    <TextBlock Grid.Column="1" Text="{Binding LiveTokenStats}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                                <ListBox ItemsSource="{Binding BenchmarkLogLines}" Height="180" FontFamily="Consolas,monospace" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Leaderboard" Classes="SectionHeader" />
                                <TextBlock Text="Double-click a row to set it as the Model override and switch Provider to LM Studio." Opacity="0.6" FontSize="11" />
                                <ItemsControl ItemsSource="{Binding Leaderboard}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent"
                                                        DoubleTapped="LeaderboardRow_DoubleTapped">
                                                <TextBlock Text="{Binding Model}" Width="240" FontSize="11" />
                                                <TextBlock Text="{Binding CompositeScore}" Width="70" FontSize="11" Opacity="0.8" />
                                                <TextBlock Text="{Binding AvgTokensPerSecond}" FontSize="11" Opacity="0.6" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== DANGER ZONE TAB ==================== -->
            <TabItem Header="Danger Zone">
                <StackPanel Spacing="10" Margin="16" MaxWidth="440" HorizontalAlignment="Left">
                    <Border Classes="Card" BorderBrush="IndianRed" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Uninstall everything" FontWeight="Bold" Foreground="IndianRed" FontSize="16" />
                            <TextBlock Text="Removes companion tooling and app-managed configuration installed by TokenOptimizer. This cannot be undone."
                                       TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                            <TextBox Text="{Binding UninstallConfirmationInput}" PlaceholderText="Type UNINSTALL to confirm" />
                            <Button Content="Uninstall Everything" Command="{Binding UninstallEverythingCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- Progress bar for the busy indicator's underlying operations -->
        <ProgressBar Grid.Row="2" Height="3" Minimum="0" Maximum="1"
                     Value="{Binding CompanionToolingProgress}"
                     IsVisible="{Binding IsCompanionToolingInstalling}" />

        <!-- Log pane: persistent across all tabs -->
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="0,1,0,0" Height="150" Margin="8,4,8,8">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Log" Classes="SubHeader" Margin="4,4,0,0" />
                <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" />
            </Grid>
        </Border>

    </Grid>

</Window>
