<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TokenOptimizer.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
        x:Class="TokenOptimizer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-icon.ico"
        Background="{DynamicResource BGSecondary}"
        Title="TokenOptimizer" Width="1100" Height="760" MinWidth="880" MinHeight="600">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- Title bar -->
        <Border Grid.Row="0" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Separator}" Background="{DynamicResource BGSecondary}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="TokenOptimizer" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource LabelSecondary}" VerticalAlignment="Center" />
                </StackPanel>
                <ProgressBar Grid.Column="1" Width="140" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main content: sidebar navigation -->
        <TabControl Grid.Row="1" TabStripPlacement="Left" Margin="0">

            <!-- ==================== SETUP TAB ==================== -->
            <TabItem Header="Setup">
                <ScrollViewer>
                    <StackPanel Margin="24">
                        <TextBlock Text="{Binding SetupStepsSummary}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid ColumnDefinitions="320,*">

                        <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,12,0">
                            <Border Classes="Card">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="1" FontWeight="Bold" />
                                        <TextBlock Text="Projects" Classes="SectionHeader" />
                                        <TextBlock Text="done" Foreground="{DynamicResource SystemGreen}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding SetupStep1Done}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding ProjectHistoryList}"
                                             SelectedItem="{Binding SelectedProject}"
                                             Height="180">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding FullPath}" FontSize="10" Foreground="{DynamicResource LabelSecondary}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="Add project folder" Classes="SubHeader" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" PlaceholderText="C:\path\to\project" Text="{Binding NewProjectPath}" />
                                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseProjectFolderCommand}" Margin="4,0,0,0" />
                                    </Grid>
                                    <Button Content="Add" Command="{Binding AddProjectCommand}" HorizontalAlignment="Stretch" />

                                    <TextBlock Text="Master folder" Classes="SubHeader" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding MasterFolderPath}" PlaceholderText="C:\path\to\projects" />
                                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseMasterFolderCommand}" Margin="4,0,0,0" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Set" Command="{Binding SetMasterFolderCommand}" />
                                        <Button Content="Refresh" Command="{Binding RefreshMasterFolderCandidatesCommand}" />
                                        <Button Content="{Binding MasterFolderTreeToggleLabel}" Command="{Binding ShowMasterFolderTreeCommand}" ToolTip.Tip="Show a tree of every subdirectory under this master folder - double-click one to launch a session there." />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding MasterFolderCandidates}" Height="120">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <CheckBox IsChecked="{Binding IsSelected}" />
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="(seen)" FontSize="10" Foreground="{DynamicResource LabelSecondary}" IsVisible="{Binding SeenBefore}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border IsVisible="{Binding IsMasterFolderTreeOpen}" BorderBrush="{DynamicResource SystemGray3}" BorderThickness="1" CornerRadius="6" Height="260" ClipToBounds="True">
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="6">
                                            <TreeView ItemsSource="{Binding MasterFolderTree}">
                                                <TreeView.ItemTemplate>
                                                    <TreeDataTemplate ItemsSource="{Binding Children}">
                                                        <TextBlock Text="{Binding Name}"
                                                                   DoubleTapped="MasterFolderTreeNode_DoubleTapped" />
                                                    </TreeDataTemplate>
                                                </TreeView.ItemTemplate>
                                            </TreeView>
                                        </ScrollViewer>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Text="{Binding NewProjectFolderName}" PlaceholderText="new folder name" Width="150" />
                                        <Button Content="Create" Command="{Binding CreateProjectFolderCommand}" />
                                    </StackPanel>
                                    <Button Content="Launch Checked" Command="{Binding LaunchSelectedCandidatesCommand}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="10">
                            <Border Classes="Card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="2" FontWeight="Bold" />
                                            <TextBlock Text="Dependencies" Classes="SectionHeader" />
                                            <TextBlock Text="done" Foreground="{DynamicResource SystemGreen}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding SetupStep2Done}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Content="Refresh" Command="{Binding RefreshAllCommand}" />
                                            <Button Content="Install Missing" Command="{Binding InstallMissingDependenciesCommand}" Classes="primary" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Dependencies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="&#10003;" Width="16" FontWeight="Bold" Foreground="{DynamicResource SystemGreen}" IsVisible="{Binding IsAvailable}" />
                                                    <TextBlock Text="&#8212;" Width="16" Foreground="{DynamicResource LabelTertiary}" IsVisible="{Binding !IsAvailable}" />
                                                    <TextBlock Text="{Binding Name}" Width="90" />
                                                    <TextBlock Text="{Binding Version}" Foreground="{DynamicResource LabelSecondary}" FontSize="10" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ProgressBar Value="{Binding DependencyInstallProgress}" Minimum="0" Maximum="1"
                                                 IsVisible="{Binding IsDependencyInstalling}" Height="6" />
                                </StackPanel>
                            </Border>

                            <Border Classes="Card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="3" FontWeight="Bold" />
                                            <TextBlock Text="Companion tooling" Classes="SectionHeader" />
                                            <TextBlock Text="done" Foreground="{DynamicResource SystemGreen}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding SetupStep3Done}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Install Companion Tooling" Command="{Binding InstallCompanionToolingCommand}" Classes="primary" />
                                    </Grid>
                                    <TextBlock Text="graphify, claude-mem, headroom, rtk, context7, context-mode, caveman, claude-md-management, impeccable, task-observer, and the Codex/Antigravity/Cursor fallback-chain CLIs."
                                               TextWrapping="Wrap" Foreground="{DynamicResource LabelTertiary}" FontSize="11" />
                                    <ProgressBar Value="{Binding CompanionToolingProgress}" Minimum="0" Maximum="1"
                                                 IsVisible="{Binding IsCompanionToolingInstalling}" Height="6" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== SESSION TAB ==================== -->
            <TabItem Header="Session">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="24">
                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Session type" Classes="SectionHeader" />
                                <TextBlock Text="Pick what this session is for and a cost preset - the priority tree below ranks every provider for that combination, sets it as the single-provider pick, and reorders the fallback chain to match."
                                           Foreground="{DynamicResource LabelSecondary}" FontSize="11" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <StackPanel Spacing="4" Width="160">
                                        <TextBlock Text="Decision type" />
                                        <ComboBox ItemsSource="{Binding SessionIntentNames}" SelectedItem="{Binding SelectedSessionIntent}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" Width="160">
                                        <TextBlock Text="Preset" />
                                        <ComboBox ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPreset}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" VerticalAlignment="Bottom">
                                        <Button Content="Re-apply" Command="{Binding ApplyIntentPresetCommand}" ToolTip.Tip="Re-run the priority tree now (it also re-runs automatically whenever you change either dropdown above)." />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Models" Classes="SectionHeader" />
                                <TextBlock Text="Tick whichever models you want available. Claude direct, Groq, and OpenCode Go all show up together in one Claude Code window's own model picker. Codex, Cursor, and Antigravity open their own separate window - they're marked below. Click a provider's name to collapse its list."
                                           Foreground="{DynamicResource LabelSecondary}" FontSize="11" TextWrapping="Wrap" />
                                <Button Content="Tick all (except separate-window ones)" Command="{Binding TickAllBridgeableModelsCommand}" HorizontalAlignment="Left" />
                                <ItemsControl ItemsSource="{Binding ModelCatalogGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Header="{Binding ProviderHeader}" IsExpanded="{Binding IsExpanded}" Margin="0,2">
                                                <ItemsControl ItemsSource="{Binding Models}" Margin="20,4,0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding DisplayLabel}" IsChecked="{Binding IsTicked}" ToolTip.Tip="{Binding Key}" Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Launch" Command="{Binding LaunchTickedModelsCommand}" IsEnabled="{Binding HasTickedModels}" Classes="primary" />
                                    <ComboBox ItemsSource="{Binding ResumeModeNames}" SelectedItem="{Binding SelectedResumeModeName}" Width="110" ToolTip.Tip="Resume mode" />
                                    <CheckBox Content="Isolate Claude config for this project (separate CLAUDE_CONFIG_DIR)" IsChecked="{Binding IsolateClaudeConfig}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Tick at least one model above to enable Launch." Foreground="{DynamicResource LabelSecondary}" FontSize="11" IsVisible="{Binding !HasTickedModels}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Fallback chain (priority order)" Classes="SectionHeader" />
                                    <StackPanel Grid.Column="1" Spacing="4" Width="200">
                                        <TextBlock Text="Launch mode" FontSize="11" Foreground="{DynamicResource LabelTertiary}" />
                                        <ComboBox ItemsSource="{Binding LaunchModeNames}" SelectedItem="{Binding SelectedLaunchMode}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Set to Auto or Custom here to launch under a fallback chain. Auto tries every provider in priority order; Custom uses the order you drag-reorder below." Foreground="{DynamicResource LabelSecondary}" FontSize="11" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding FallbackChain}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="&#10003;" Width="16" FontWeight="Bold" Foreground="{DynamicResource SystemGreen}" IsVisible="{Binding IsAvailable}" />
                                                <TextBlock Text="&#8212;" Width="16" Foreground="{DynamicResource LabelTertiary}" IsVisible="{Binding !IsAvailable}" />
                                                <TextBlock Text="{Binding ProviderName}" Width="100" />
                                                <TextBlock Text="{Binding UnavailableReason}" Foreground="{DynamicResource LabelSecondary}" FontSize="10" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="Card" IsVisible="{Binding IsCustomChainSelected}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Custom fallback chain" Classes="SectionHeader" />
                                        <TextBlock Text="Drag to reorder, uncheck to exclude. Select &quot;Custom (fallback chain)&quot; as the Launch mode above to use this order." Foreground="{DynamicResource LabelSecondary}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Save Order" Command="{Binding SaveCustomFallbackOrderCommand}" VerticalAlignment="Top" />
                                </Grid>
                                <ListBox x:Name="CustomChainListBox" ItemsSource="{Binding CustomChainOrder}" Height="180">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                  PointerPressed="CustomChainItem_PointerPressed"
                                                  PointerReleased="CustomChainItem_PointerReleased"
                                                  Background="Transparent">
                                                <TextBlock Grid.Column="0" Text="::" FontWeight="Bold" Foreground="{DynamicResource LabelTertiary}" Width="20" Cursor="SizeAll" />
                                                <CheckBox Grid.Column="1" Content="{Binding ProviderName}" IsChecked="{Binding IsIncluded}" />
                                                <TextBlock Grid.Column="2" Text="{Binding SortIndex}" Foreground="{DynamicResource LabelTertiary}" FontSize="10" Width="20" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Content="&#8593;" ToolTip.Tip="Move up"
                                                        Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).MoveCustomChainItemUpCommand}"
                                                        CommandParameter="{Binding}" Padding="8,2" />
                                                <Button Grid.Column="4" Content="&#8595;" ToolTip.Tip="Move down"
                                                        Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).MoveCustomChainItemDownCommand}"
                                                        CommandParameter="{Binding}" Padding="8,2" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Fallback credentials" Classes="SectionHeader" />
                                <TextBlock Text="API keys for the fallback providers that need one." Foreground="{DynamicResource LabelSecondary}" FontSize="11" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Text="{Binding CodexApiKeyInput}" PlaceholderText="Opt-in marker for Codex (jcode manages auth)" Width="220" PasswordChar="*" />
                                    <Button Content="Save Codex Key" Command="{Binding SetCodexCredentialCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Text="{Binding GroqApiKeyInput}" PlaceholderText="GROQ_API_KEY for Groq" Width="220" PasswordChar="*" />
                                    <Button Content="Save Groq Key" Command="{Binding SetGroqCredentialCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Text="{Binding OpenCodeApiKeyInput}" PlaceholderText="API key for OpenCode Go" Width="220" PasswordChar="*" />
                                    <Button Content="Save OpenCode Key" Command="{Binding SetOpenCodeCredentialCommand}" />
                                </StackPanel>
                                <TextBlock Text="OpenCode Go models: mimo-v2.5 (default, balanced), glm-5 (cheap), minimax-m2.7, kimi-k2.5, qwen3.8-max, glm-5.2 (optional, expensive) - or type any model id it offers in the Model override field above."
                                           Foreground="{DynamicResource LabelSecondary}" FontSize="11" TextWrapping="Wrap" />

                                <Border BorderBrush="{DynamicResource SystemGray3}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Login: Antigravity" FontWeight="SemiBold" />
                                        <TextBlock Text="Opens the Antigravity CLI in a new window - sign in there (OAuth), then it's available in the fallback chain." Foreground="{DynamicResource LabelSecondary}" FontSize="11" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Login: Antigravity" Command="{Binding LoginAntigravityCommand}" />
                                            <Button Content="Check" Command="{Binding CheckAntigravityLoginCommand}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding AntigravityLoginStatusText}" FontSize="11" Foreground="{DynamicResource LabelSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="{DynamicResource SystemGray3}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Login: Cursor" FontWeight="SemiBold" />
                                        <TextBlock Text="Opens 'cursor-agent login' in a new window - sign in there, then it's available in the fallback chain." Foreground="{DynamicResource LabelSecondary}" FontSize="11" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Login: Cursor" Command="{Binding LoginCursorCommand}" />
                                            <Button Content="Check" Command="{Binding CheckCursorLoginCommand}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding CursorLoginStatusText}" FontSize="11" Foreground="{DynamicResource LabelSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== DASHBOARD TAB ==================== -->
            <TabItem Header="Dashboard">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="24">
                        <Border Classes="Card">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Active session" Classes="SectionHeader" />
                                    <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshDashboardCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding ActiveProviderLabel}" FontWeight="SemiBold" />
                                <TextBlock Text="Set the provider and fallback mode in the Session tab - it applies to the next launch." Foreground="{DynamicResource LabelSecondary}" FontSize="11" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding TokenUsageSummaryText}" Foreground="{DynamicResource LabelTertiary}" FontSize="12"
                                           ToolTip.Tip="Via ccusage - local, offline, reads Claude Code/Codex/etc session logs already on disk. No proxy, no upload." />
                                <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsDashboardRefreshing}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Session handoff" Classes="SectionHeader" />
                                <TextBlock Text="Exports the current project's handoff file regardless of which model launched last." Foreground="{DynamicResource LabelSecondary}" FontSize="11" TextWrapping="Wrap" />
                                <Button Content="Export Handoff" Command="{Binding ExportHandoffCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Skills in use (Claude Code terminal)" Classes="SectionHeader" />
                                <TextBlock Text="Every provider routes through this one terminal, so these are always active regardless of the backend model selected above." Foreground="{DynamicResource LabelSecondary}" FontSize="11" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding ActiveSkills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Plugins in use (Claude Code terminal)" Classes="SectionHeader" />
                                <ItemsControl ItemsSource="{Binding ActivePlugins}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Guide: what's available, and when to use it" Classes="SectionHeader" />
                                <TextBlock Text="Every skill/plugin this Claude Code environment can reach, with its own description - the same text Claude reads to decide when to trigger it." Foreground="{DynamicResource LabelSecondary}" FontSize="11" TextWrapping="Wrap" />

                                <TextBlock Text="Skills" Classes="SubHeader" />
                                <Border BorderBrush="{DynamicResource SystemGray3}" BorderThickness="1" CornerRadius="6" Height="220">
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding SkillGuide}" Margin="6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="160,Auto,*" Margin="0,3">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{DynamicResource LabelTertiary}" FontSize="10" Margin="6,0" VerticalAlignment="Top" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="{DynamicResource LabelTertiary}" FontSize="11" TextWrapping="Wrap" Margin="6,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <TextBlock Text="Plugins" Classes="SubHeader" />
                                <Border BorderBrush="{DynamicResource SystemGray3}" BorderThickness="1" CornerRadius="6" Height="160">
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding PluginGuide}" Margin="6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="160,*" Margin="0,3">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{DynamicResource LabelTertiary}" FontSize="11" TextWrapping="Wrap" Margin="6,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== DANGER ZONE TAB ==================== -->
            <TabItem Header="Danger Zone">
                <StackPanel Spacing="10" Margin="24" MaxWidth="440" HorizontalAlignment="Left">
                    <Border Classes="Card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Cache" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="Isolated Claude profiles (-IsolateClaudeConfig) are a full copy of ~/.claude per project - one folder per distinct project, never cleaned up automatically."
                                       TextWrapping="Wrap" Foreground="{DynamicResource LabelTertiary}" FontSize="12" />
                            <TextBlock Text="{Binding CacheSummaryText}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Scan Cache" Command="{Binding RefreshCacheInfoCommand}" />
                                <Button Content="Clear Stale (30+ days)" Command="{Binding ClearStaleCacheCommand}" />
                            </StackPanel>
                            <TextBox Text="{Binding ClearCacheConfirmationInput}" PlaceholderText="Type CLEAR to confirm" />
                            <Button Content="Clear All Cached Profiles" Command="{Binding ClearAllCacheCommand}" HorizontalAlignment="Stretch" Classes="destructive" />
                        </StackPanel>
                    </Border>
                    <Border Classes="Card" BorderBrush="{DynamicResource SystemRed}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Uninstall everything" FontWeight="Bold" Foreground="{DynamicResource SystemRed}" FontSize="16" />
                            <TextBlock Text="Removes companion tooling and app-managed configuration installed by TokenOptimizer. This cannot be undone."
                                       TextWrapping="Wrap" Foreground="{DynamicResource LabelTertiary}" FontSize="12" />
                            <TextBox Text="{Binding UninstallConfirmationInput}" PlaceholderText="Type UNINSTALL to confirm" />
                            <Button Content="Uninstall Everything" Command="{Binding UninstallEverythingCommand}" HorizontalAlignment="Stretch" Classes="destructive" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- Progress bar for the busy indicator's underlying operations -->
        <ProgressBar Grid.Row="2" Height="3" Minimum="0" Maximum="1"
                     Value="{Binding CompanionToolingProgress}"
                     IsVisible="{Binding IsCompanionToolingInstalling}" />

        <!-- Log pane: persistent across all tabs -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Height="150" Margin="0">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Log" Classes="SubHeader" Margin="24,8,0,4" />
                <ListBox Grid.Row="1" Classes="log" ItemsSource="{Binding LogLines}" Margin="16,0,16,8" />
            </Grid>
        </Border>

    </Grid>

</Window>
