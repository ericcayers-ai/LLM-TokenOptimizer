{
  "name": "llm-token-optimizer",
  "displayName": "LLM-TokenOptimizer",
  "description": "VS Code front door onto the TokenOptimizer app's headless CLI (TokenOptimizer.App.exe --cli): Graphify + companion-tooling setup, provider/fallback-chain session launches, and session transfers, all driven by the same C# app the desktop UI uses. No PowerShell dependency.",
  "version": "6.0.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "llmTokenOptimizer.quickMenu",
        "title": "LLM-TokenOptimizer: Start",
        "icon": "$(rocket)"
      },
      {
        "command": "llmTokenOptimizer.openCurrentWorkspace",
        "title": "LLM-TokenOptimizer: Open Current Workspace as Project",
        "icon": "$(folder-opened)"
      },
      {
        "command": "llmTokenOptimizer.openLauncherForFolder",
        "title": "LLM-TokenOptimizer: Open Launcher (Master Folder Picker)",
        "icon": "$(list-selection)"
      },
      {
        "command": "llmTokenOptimizer.changeMasterFolder",
        "title": "LLM-TokenOptimizer: Change Master Folder",
        "icon": "$(folder)"
      },
      {
        "command": "llmTokenOptimizer.resetConfig",
        "title": "LLM-TokenOptimizer: Reset Configuration",
        "icon": "$(trash)"
      },
      {
        "command": "llmTokenOptimizer.setupProxy",
        "title": "LLM-TokenOptimizer: Set Up Fallback Providers (Antigravity / Codex / Cursor / Groq)",
        "icon": "$(key)"
      },
      {
        "command": "llmTokenOptimizer.transferToCodex",
        "title": "LLM-TokenOptimizer: Transfer Session to Codex",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "llmTokenOptimizer.transferToCursor",
        "title": "LLM-TokenOptimizer: Transfer Session to Cursor",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "llmTokenOptimizer.continueLocally",
        "title": "LLM-TokenOptimizer: Continue Locally",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "llmTokenOptimizer.openDashboard",
        "title": "LLM-TokenOptimizer: Open Dashboard",
        "icon": "$(graph-line)"
      },
      {
        "command": "llmTokenOptimizer.openApp",
        "title": "LLM-TokenOptimizer: Open TokenOptimizer App",
        "icon": "$(window)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "llmTokenOptimizer",
          "title": "LLM-TokenOptimizer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "llmTokenOptimizer": [
        {
          "id": "llmTokenOptimizerView",
          "name": "LLM-TokenOptimizer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "llmTokenOptimizerView",
        "contents": "Manage Graphify + Claude Code project/session windows without leaving VS Code.\n[$(rocket) Start](command:llmTokenOptimizer.quickMenu)\nOr ask the agent: `@tokenoptimizer` in the Chat view."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "llmTokenOptimizer.quickMenu",
          "when": "view == llmTokenOptimizerView",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "llmTokenOptimizer.quickMenu",
          "when": "true"
        },
        {
          "command": "llmTokenOptimizer.openCurrentWorkspace",
          "when": "false"
        },
        {
          "command": "llmTokenOptimizer.openLauncherForFolder",
          "when": "false"
        },
        {
          "command": "llmTokenOptimizer.changeMasterFolder",
          "when": "false"
        },
        {
          "command": "llmTokenOptimizer.resetConfig",
          "when": "false"
        },
        {
          "command": "llmTokenOptimizer.setupProxy",
          "when": "false"
        },
        {
          "command": "llmTokenOptimizer.transferToCodex",
          "when": "false"
        },
        {
          "command": "llmTokenOptimizer.transferToCursor",
          "when": "false"
        },
        {
          "command": "llmTokenOptimizer.continueLocally",
          "when": "false"
        },
        {
          "command": "llmTokenOptimizer.openDashboard",
          "when": "false"
        },
        {
          "command": "llmTokenOptimizer.openApp",
          "when": "true"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "llmTokenOptimizer.agent",
        "fullName": "LLM-TokenOptimizer",
        "name": "tokenoptimizer",
        "description": "Open Claude Code project/session windows, Graphify + companion tooling setup, from VS Code's Chat view.",
        "isSticky": true
      }
    ],
    "configuration": {
      "title": "LLM-TokenOptimizer",
      "properties": {
        "llmTokenOptimizer.model": {
          "type": "string",
          "default": "",
          "description": "Session-only model override forwarded to `--cli launch --model`. Leave blank to use the provider's own default (or, for Unsloth, the app's configured local model)."
        },
        "llmTokenOptimizer.isolateClaudeConfig": {
          "type": "boolean",
          "default": false,
          "description": "Forward --isolate: give each project its own CLAUDE_CONFIG_DIR instead of sharing ~/.claude."
        },
        "llmTokenOptimizer.appExecutablePath": {
          "type": "string",
          "default": "",
          "description": "Path to TokenOptimizer.App.exe. Leave blank to auto-detect (bundled next to this extension, or a local `dotnet build` under this repo's app/ folder)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.3.9",
    "glob": "^10.3.10",
    "mocha": "^10.3.0",
    "typescript": "^5.4.0"
  }
}
