# VS Code extension build artifacts
vscode-extension/node_modules/
vscode-extension/out/
vscode-extension/.vscode-test/
vscode-extension/*.vsix.map

# OS/editor cruft
.DS_Store
Thumbs.db

# Local Claude Code config/state - contains machine-specific paths
# (.claude/settings.json, settings.local.json) that don't belong in a
# shared repo. Project-level guidance lives in the root CLAUDE.md instead.
.claude/

# Graphify's generated graph/cache output - local, machine-specific,
# regenerated on demand. Never commit branch.json, worktree.json,
# needs_update, or cache/ per this project's own CLAUDE.md graphify rules.
.graphify/
.graphify_*_installed
graphify-out/
vscode-extension/src/.graphify/

# Python bytecode cache
__pycache__/
*.pyc

# run_benchmarks.py OUTPUT - per-machine hardware results and run logs, not
# repo content. Anyone running the pipeline generates their own; committing
# one person's numbers would misrepresent them as canonical (different
# CPU/GPU/RAM, different model catalog availability, different day's HF/LM
# Studio catalog state). Re-run with `--rescore` any time to regenerate
# benchmark_summary.json/csv locally. Broad globs (not just exact filenames)
# so a renamed/rotated log or an extra benchmark_<model>.json variant is
# still caught automatically.
benchmark_*.json
benchmark_*.csv
benchmark_summary.*
benchmark_results_*
run_benchmarks*.log
*.benchmark.log
BENCHMARK_REPORT.md
BENCHMARK_REPORT_*.md

# Generic build/dependency/log noise that shouldn't ever land in a commit,
# regardless of which subproject (app/, vscode-extension/, root Python)
# produces it.
node_modules/
*.log
*.tmp
*.temp
.env
.env.*
!.env.example
*.msi
*.vsix
# Keep the canonical published extension package.
!app/publish/llm-token-optimizer.vsix
*.egg-info/
app/publish/**/*.pdb
.vscode-test/
!docs/benchmarks/**
.pytest_cache/
.mypy_cache/
.ruff_cache/

.superpowers/

# Python sdist/wheel build output
freetoken_local/build/
